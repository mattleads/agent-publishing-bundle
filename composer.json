{
    "name": "mattleads/agent-publishing-bundle",
    "description": "Publishing API and MCP server for Symfony sites: AI agents, marketing platforms and webmasters draft, approve and publish articles and read view and referrer counts. No frontend.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "publishing", "blog", "api", "mcp", "ai-agents", "seo", "geo", "aeo", "analytics", "headless"],
    "authors": [
        { "name": "Matvei (Matt) Mochalkin", "email": "matthew.mochalkin@gmail.com", "homepage": "https://github.com/mattleads" }
    ],
    "homepage": "https://github.com/mattleads/agent-publishing-bundle",
    "support": {
        "issues": "https://github.com/mattleads/agent-publishing-bundle/issues",
        "source": "https://github.com/mattleads/agent-publishing-bundle"
    },
    "require": {
        "php": ">=8.2",
        "psr/clock": "^1.0",
        "symfony/config": "^6.4|^7.0|^8.0",
        "symfony/console": "^6.4|^7.0|^8.0",
        "symfony/dependency-injection": "^6.4|^7.0|^8.0",
        "symfony/event-dispatcher": "^6.4|^7.0|^8.0",
        "symfony/framework-bundle": "^6.4|^7.0|^8.0",
        "symfony/http-foundation": "^6.4|^7.0|^8.0",
        "symfony/http-kernel": "^6.4|^7.0|^8.0",
        "symfony/routing": "^6.4|^7.0|^8.0",
        "symfony/security-bundle": "^6.4|^7.0|^8.0",
        "symfony/security-core": "^6.4|^7.0|^8.0",
        "symfony/security-http": "^6.4|^7.0|^8.0",
        "symfony/string": "^6.4|^7.0|^8.0",
        "symfony/translation-contracts": "^3.0",
        "symfony/uid": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.13|^3.0",
        "doctrine/orm": "^3.3",
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "^6.4|^7.0|^8.0",
        "symfony/clock": "^6.4|^7.0|^8.0",
        "symfony/messenger": "^6.4|^7.0|^8.0",
        "symfony/yaml": "^6.4|^7.0|^8.0"
    },
    "suggest": {
        "doctrine/orm": "To use the bundled Doctrine storage for articles and API keys.",
        "symfony/mcp-bundle": "To expose the publishing tools to AI agents over the Model Context Protocol."
    },
    "autoload": {
        "psr-4": { "MattLeads\\AgentPublishingBundle\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "MattLeads\\AgentPublishingBundle\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "php-http/discovery": false }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": ["@cs", "@stan", "@test"]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
